page {
    min-height: 100%;
    background: #F4F6FB;
    color: #101828;
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
    font-size: 28rpx;
    font-size: calc(28rpx * var(--fs, 1));
    -webkit-font-smoothing: antialiased;
}

view,
text,
input,
textarea,
button {
    box-sizing: border-box;
}

button {
    border-radius: 24rpx;
}

button::after {
    border: none;
}

/* ---------- 字号档位 ---------- */
.fs-s {
    --fs: 0.9;
}

.fs-m {
    --fs: 1;
}

.fs-l {
    --fs: 1.15;
}

.fs-xl {
    --fs: 1.3;
}

/* ---------- 字型档位（系统内置字体，作用于根容器） ---------- */
.ff-kai {
    font-family: "Kaiti SC", "STKaiti", KaiTi, "楷体", "SimKai", serif;
}

.ff-song {
    font-family: "Songti SC", "STSong", SimSun, "宋体", serif;
}

.ff-hei {
    font-family: "PingFang SC", "Heiti SC", "Microsoft YaHei", sans-serif;
}

.ff-sys {
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", sans-serif;
}

/* ---------- 点选控件 ---------- */
.opt-row {
    display: flex;
    flex-wrap: wrap;
    margin-top: 16rpx;
    margin-bottom: -12rpx;
}

.opt-chip {
    margin: 0 14rpx 12rpx 0;
    padding: 14rpx 26rpx;
    border: 2rpx solid rgba(16, 24, 40, 0.06);
    border-radius: 999rpx;
    background: #FBFCFE;
    color: #5A6274;
    font-size: 26rpx;
    font-size: calc(26rpx * var(--fs, 1));
    line-height: 1.25;
    box-shadow: 0 4rpx 12rpx rgba(16, 24, 40, 0.04);
    transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
}

.opt-chip.is-active {
    border-color: #A9B8FF;
    background: linear-gradient(135deg, #EEF2FF 0%, #ECE9FF 100%);
    color: #3546C9;
    font-weight: 600;
    box-shadow: 0 8rpx 18rpx rgba(86, 102, 255, 0.18);
}

/* ---------- 底部选择面板 ---------- */
.sheet-mask {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 90;
    background: rgba(12, 18, 34, 0.44);
}

.sheet {
    position: fixed;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 91;
    display: flex;
    flex-direction: column;
    max-height: 76vh;
    padding: 34rpx 32rpx 0;
    border-radius: 36rpx 36rpx 0 0;
    background: #ffffff;
    box-shadow: 0 -12rpx 48rpx rgba(12, 18, 34, 0.16);
    overflow: hidden;
}

.sheet::before {
    content: '';
    position: absolute;
    top: 14rpx;
    left: 50%;
    width: 64rpx;
    height: 8rpx;
    border-radius: 999rpx;
    background: #E3E7F0;
    transform: translateX(-50%);
}

.sheet-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 14rpx;
}

.sheet-title {
    color: #101828;
    font-size: 32rpx;
    font-size: calc(32rpx * var(--fs, 1));
    font-weight: 700;
}

.sheet-close {
    padding: 8rpx 0 8rpx 24rpx;
    color: #4F63FF;
    font-size: 27rpx;
    font-size: calc(27rpx * var(--fs, 1));
    font-weight: 600;
}

.sheet-tip {
    margin-bottom: 18rpx;
    color: #98A2B3;
    font-size: 23rpx;
    font-size: calc(23rpx * var(--fs, 1));
    line-height: 1.4;
}

.sheet-scroll {
    flex: 1;
    max-height: 56vh;
}

.sheet-list {
    padding-bottom: 8rpx;
}

.sheet-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12rpx;
    padding: 24rpx 22rpx;
    border: 2rpx solid rgba(16, 24, 40, 0.05);
    border-radius: 20rpx;
    background: #FBFCFE;
    color: #2A3346;
    font-size: 28rpx;
    font-size: calc(28rpx * var(--fs, 1));
    line-height: 1.35;
    box-shadow: 0 4rpx 12rpx rgba(16, 24, 40, 0.04);
    transition: background 0.16s ease, box-shadow 0.16s ease;
}

.sheet-option.is-active {
    border-color: #A9B8FF;
    background: linear-gradient(135deg, #EEF2FF 0%, #ECE9FF 100%);
    color: #3546C9;
    font-weight: 600;
    box-shadow: 0 10rpx 22rpx rgba(86, 102, 255, 0.16);
}

.sheet-option-text {
    flex: 1;
    min-width: 0;
}

.sheet-option-check {
    margin-left: 18rpx;
    color: #4F63FF;
    font-size: 28rpx;
    font-size: calc(28rpx * var(--fs, 1));
    font-weight: 700;
}

.sheet-preview {
    display: flex;
    flex-direction: column;
    margin-top: 18rpx;
    padding: 24rpx 26rpx;
    border: 2rpx solid #E3E9FA;
    border-radius: 22rpx;
    background: linear-gradient(135deg, #F6F8FF 0%, #F1F3FF 60%, #F7F3FF 100%);
    box-shadow: 0 10rpx 24rpx rgba(86, 102, 255, 0.08);
}

.sheet-preview-title {
    color: #3546C9;
    font-size: 30rpx;
    font-size: calc(30rpx * var(--fs, 1));
    font-weight: 600;
    line-height: 1.4;
}

.sheet-preview-sub {
    margin-top: 8rpx;
    color: #7C86A8;
    font-size: 24rpx;
    font-size: calc(24rpx * var(--fs, 1));
    line-height: 1.4;
}

/* ---------- 设置面板：提醒方式开关 ---------- */
.switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 14rpx;
    padding: 20rpx 24rpx;
    border: 2rpx solid #E3E9FA;
    border-radius: 22rpx;
    background: #FCFDFF;
}

.switch-info {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding-right: 16rpx;
}

.switch-title {
    color: #16191F;
    font-size: 27rpx;
    font-size: calc(27rpx * var(--fs, 1));
    font-weight: 600;
}

.switch-sub {
    margin-top: 6rpx;
    color: #7C86A8;
    font-size: 23rpx;
    font-size: calc(23rpx * var(--fs, 1));
    line-height: 1.35;
}

/* ---------- 设置面板：可滚动内容区 ---------- */
.sheet-body {
    flex: 1;
    height: 0;
    min-height: 0;
}

.cal-note {
    display: block;
    margin: 16rpx 2rpx 8rpx;
    color: #9AA3B7;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
    line-height: 1.5;
}

/* ---------- 提醒可靠性卡片 ---------- */
.push-card {
    margin-top: 14rpx;
    padding: 22rpx 24rpx 20rpx;
    border: 2rpx solid #E3E9FA;
    border-radius: 22rpx;
    background: #FCFDFF;
}

.push-line {
    display: flex;
    align-items: flex-start;
    padding: 8rpx 0;
}

.push-dot {
    width: 14rpx;
    height: 14rpx;
    border-radius: 50%;
    margin: 12rpx 14rpx 0 0;
    flex-shrink: 0;
}

.push-dot-on {
    background: #1FA971;
}

.push-dot-off {
    background: #C6CCDA;
}

.push-info {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.push-title {
    color: #16191F;
    font-size: 26rpx;
    font-size: calc(26rpx * var(--fs, 1));
    font-weight: 600;
    line-height: 1.4;
}

.push-sub {
    margin-top: 4rpx;
    color: #7C86A8;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
    line-height: 1.45;
}

.push-actions {
    display: flex;
    margin-top: 16rpx;
}

.push-btn {
    flex: 1;
    height: 68rpx;
    border-radius: 18rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #2B5CE6;
    color: #FFFFFF;
    font-size: 25rpx;
    font-size: calc(25rpx * var(--fs, 1));
    font-weight: 600;
}

.push-btn-ghost {
    margin-left: 16rpx;
    background: #F1F4FB;
    color: #3546C9;
    border: 2rpx solid #DCE3F6;
}

.push-btn-hover {
    opacity: 0.85;
}

.push-test {
    display: block;
    margin-top: 14rpx;
    text-align: center;
    color: #4F63FF;
    font-size: 23rpx;
    font-size: calc(23rpx * var(--fs, 1));
}

/* ---------- 锁屏错过提醒提示条 ---------- */
.missed-card {
    display: flex;
    align-items: center;
    margin: 18rpx 0 0;
    padding: 20rpx 24rpx;
    border-radius: 20rpx;
    background: #FFF7E8;
    border: 2rpx solid #F0DDB6;
}

.missed-main {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.missed-title {
    color: #8A5B12;
    font-size: 25rpx;
    font-size: calc(25rpx * var(--fs, 1));
    font-weight: 700;
}

.missed-text {
    margin-top: 6rpx;
    color: #9A7331;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
    line-height: 1.45;
}

.missed-close {
    margin-left: 18rpx;
    color: #8A5B12;
    font-size: 23rpx;
    font-size: calc(23rpx * var(--fs, 1));
    font-weight: 600;
}

.sheet-safe {
    height: 28rpx;
    height: calc(28rpx + env(safe-area-inset-bottom));
}
