.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 24rpx 32rpx 200rpx;
    padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
    background: linear-gradient(180deg, #EEF1FF 0rpx, #F3F5FB 300rpx, #F4F6FB 100%);
    background-repeat: no-repeat;
}

/* ---------- 顶部概览 ---------- */
@keyframes rise-in {
    from {
        opacity: 0;
        transform: translateY(18rpx);
    }

    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.hero {
    position: relative;
    display: flex;
    overflow: hidden;
    flex-direction: column;
    padding: 32rpx 30rpx 34rpx;
    border-radius: 34rpx;
    background: linear-gradient(135deg, #4F6BFF 0%, #6A5BFF 52%, #8B5CF6 100%);
    box-shadow: 0 10rpx 20rpx rgba(60, 78, 220, 0.18), 0 26rpx 52rpx rgba(60, 78, 220, 0.28), inset 0 2rpx 0 rgba(255, 255, 255, 0.3);
    animation: rise-in 0.42s ease both;
}

.hero::after {
    content: '';
    position: absolute;
    top: -140rpx;
    right: -110rpx;
    width: 340rpx;
    height: 340rpx;
    border-radius: 50%;
    background: radial-gradient(circle at center, rgba(255, 255, 255, 0.32) 0%, rgba(255, 255, 255, 0) 68%);
}

.hero-top {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.hero-entry-row {
    display: flex;
    flex-shrink: 0;
    align-items: center;
}

.font-entry {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    margin-left: 18rpx;
    padding: 10rpx 18rpx;
    border: 2rpx solid rgba(255, 255, 255, 0.32);
    border-radius: 999rpx;
    background: rgba(255, 255, 255, 0.2);
}

/* 头像入口：与「设置」胶囊同款外观 */
.hero-avatar {
    display: flex;
    width: 44rpx;
    height: 44rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #5B76FF 0%, #8B5CF6 100%);
    color: #ffffff;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
    font-weight: 700;
    line-height: 1;
}

.font-entry-hover {
    background: rgba(255, 255, 255, 0.3);
}

.font-entry-text {
    color: #ffffff;
    font-size: 26rpx;
    font-size: calc(26rpx * var(--fs, 1));
    font-weight: 700;
    line-height: 1;
}

.font-entry-label {
    margin-left: 8rpx;
    color: rgba(255, 255, 255, 0.86);
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
    line-height: 1;
}

.hero-eyebrow {
    position: relative;
    z-index: 1;
    color: rgba(255, 255, 255, 0.82);
    font-size: 24rpx;
    font-size: calc(24rpx * var(--fs, 1));
    letter-spacing: 1rpx;
}

.hero-title {
    position: relative;
    z-index: 1;
    margin-top: 16rpx;
    color: #ffffff;
    font-size: 48rpx;
    font-size: calc(48rpx * var(--fs, 1));
    font-weight: 700;
    line-height: 1.3;
    text-shadow: 0 6rpx 18rpx rgba(18, 26, 80, 0.2);
}

.hero-hint-row {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    margin-top: 16rpx;
}

.hero-dot {
    width: 10rpx;
    height: 10rpx;
    flex-shrink: 0;
    margin-right: 12rpx;
    border-radius: 50%;
    background: #ffffff;
    box-shadow: 0 0 0 6rpx rgba(255, 255, 255, 0.22);
}

.hero-hint {
    color: rgba(255, 255, 255, 0.92);
    font-size: 26rpx;
    font-size: calc(26rpx * var(--fs, 1));
    line-height: 1.4;
}

/* ---------- 视图切换 ---------- */
.segment {
    display: flex;
    margin-top: 26rpx;
    padding: 8rpx;
    border-radius: 999rpx;
    background: #E7EAF6;
    box-shadow: inset 0 2rpx 8rpx rgba(16, 24, 40, 0.07);
}

.segment-item {
    flex: 1;
    padding: 16rpx 0;
    border-radius: 999rpx;
    color: #667085;
    font-size: 28rpx;
    font-size: calc(28rpx * var(--fs, 1));
    text-align: center;
    transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
}

.segment-item.is-active {
    background: #ffffff;
    color: #3B4BFF;
    font-weight: 600;
    box-shadow: 0 6rpx 16rpx rgba(16, 24, 40, 0.12);
}

/* ---------- 分类筛选 ---------- */
.filter-scroll {
    width: 100%;
    margin-top: 22rpx;
    white-space: nowrap;
}

.filter-track {
    display: inline-flex;
    padding: 2rpx 0 8rpx;
}

.chip {
    display: inline-flex;
    align-items: center;
    margin-right: 16rpx;
    padding: 14rpx 28rpx;
    border: 2rpx solid rgba(16, 24, 40, 0.06);
    border-radius: 999rpx;
    background: #ffffff;
    color: #5A6274;
    font-size: 26rpx;
    font-size: calc(26rpx * var(--fs, 1));
    line-height: 1;
    box-shadow: 0 4rpx 12rpx rgba(16, 24, 40, 0.05);
    transition: background 0.18s ease, color 0.18s ease, box-shadow 0.18s ease;
}

.chip.is-active {
    border-color: transparent;
    background: linear-gradient(135deg, #5B76FF 0%, #7B5CFF 100%);
    color: #ffffff;
    font-weight: 600;
    box-shadow: 0 10rpx 22rpx rgba(86, 102, 255, 0.3);
}

.chip-dot {
    width: 10rpx;
    height: 10rpx;
    margin-right: 12rpx;
    border-radius: 50%;
}

/* ---------- 状态卡片 ---------- */
.error-card,
.loading-card {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    margin-top: 32rpx;
    padding: 56rpx 40rpx;
    border-radius: 30rpx;
    background: linear-gradient(180deg, #ffffff 0%, #FBFCFE 100%);
    box-shadow: 0 4rpx 10rpx rgba(16, 24, 40, 0.04), 0 18rpx 40rpx rgba(16, 24, 40, 0.08);
}

.error-text {
    color: #D14343;
    font-size: 28rpx;
    font-size: calc(28rpx * var(--fs, 1));
}

.error-action {
    margin-top: 24rpx;
    padding: 14rpx 40rpx;
    border-radius: 999rpx;
    background: #EEF1FF;
    color: #3B4BFF;
    font-size: 26rpx;
    font-size: calc(26rpx * var(--fs, 1));
    font-weight: 600;
}

.loading-spinner {
    width: 44rpx;
    height: 44rpx;
    border: 6rpx solid #E3E8FB;
    border-top-color: #5B76FF;
    border-radius: 50%;
    animation: spin 0.9s linear infinite;
}

.loading-text {
    margin-top: 20rpx;
    color: #8A93A6;
    font-size: 26rpx;
    font-size: calc(26rpx * var(--fs, 1));
}

@keyframes spin {
    to {
        transform: rotate(360deg);
    }
}

/* ---------- 空态 ---------- */
.empty-card {
    display: flex;
    align-items: center;
    flex-direction: column;
    margin-top: 28rpx;
    padding: 72rpx 40rpx;
    border-radius: 30rpx;
    background: linear-gradient(180deg, #ffffff 0%, #FAFBFE 100%);
    box-shadow: 0 4rpx 10rpx rgba(16, 24, 40, 0.04), 0 18rpx 40rpx rgba(16, 24, 40, 0.08);
}

.empty-card-small {
    margin-top: 8rpx;
    padding: 56rpx 40rpx;
}

.empty-clock {
    position: relative;
    width: 92rpx;
    height: 92rpx;
    margin-bottom: 24rpx;
    border: 4rpx solid #D8E1FB;
    border-radius: 50%;
    box-shadow: inset 0 2rpx 8rpx rgba(91, 118, 255, 0.12);
}

.empty-hand-hour,
.empty-hand-minute {
    position: absolute;
    left: 50%;
    bottom: 50%;
    width: 4rpx;
    border-radius: 4rpx;
    background: #9DB6F4;
    transform-origin: bottom center;
}

.empty-hand-hour {
    height: 24rpx;
    transform: translateX(-50%) rotate(40deg);
}

.empty-hand-minute {
    height: 32rpx;
    transform: translateX(-50%) rotate(120deg);
}

.empty-title {
    color: #101828;
    font-size: 30rpx;
    font-size: calc(30rpx * var(--fs, 1));
    font-weight: 600;
}

.empty-text {
    margin-top: 12rpx;
    color: #8A93A6;
    font-size: 25rpx;
    font-size: calc(25rpx * var(--fs, 1));
    line-height: 1.6;
    text-align: center;
}

/* ---------- 按日分组 ---------- */
.day-group {
    margin-top: 34rpx;
}

.day-head {
    display: flex;
    align-items: baseline;
    padding: 0 8rpx 16rpx;
}

.day-label {
    background: linear-gradient(120deg, #3B4BFF 0%, #7B5CFF 70%, #A05CF6 100%);
    -webkit-background-clip: text;
    color: transparent;
    font-size: 30rpx;
    font-size: calc(30rpx * var(--fs, 1));
    font-weight: 700;
}

.day-label-muted {
    background: none;
    color: #98A2B3;
}

.day-sub {
    margin-left: 14rpx;
    color: #8A93A6;
    font-size: 24rpx;
    font-size: calc(24rpx * var(--fs, 1));
}

.day-count {
    margin-left: auto;
    padding: 4rpx 14rpx;
    border-radius: 999rpx;
    background: #EAEEF9;
    color: #5A6274;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
}

/* ---------- 行程卡片 ---------- */
.trip-card {
    position: relative;
    display: flex;
    align-items: flex-start;
    margin-bottom: 18rpx;
    padding: 28rpx 28rpx 28rpx 24rpx;
    border: 2rpx solid rgba(16, 24, 40, 0.04);
    border-radius: 28rpx;
    background: linear-gradient(180deg, #ffffff 0%, #FCFDFF 100%);
    box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.04), 0 16rpx 34rpx rgba(16, 24, 40, 0.07);
    overflow: hidden;
    transition: transform 0.16s ease, box-shadow 0.16s ease;
}

.trip-card-hover {
    transform: translateY(-3rpx);
    box-shadow: 0 8rpx 18rpx rgba(16, 24, 40, 0.07), 0 24rpx 48rpx rgba(16, 24, 40, 0.12);
}

.trip-card.is-dim {
    opacity: 0.64;
}

.trip-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 8rpx;
}

.trip-check {
    display: flex;
    width: 40rpx;
    height: 40rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    margin: 6rpx 20rpx 0 20rpx;
    border: 2rpx solid #D3D9E6;
    border-radius: 50%;
    background: #FBFCFE;
    transition: background 0.18s ease, border-color 0.18s ease;
}

.trip-check.is-done {
    border-color: transparent;
    background: linear-gradient(135deg, #23C08A 0%, #12A67C 100%);
    box-shadow: 0 6rpx 14rpx rgba(18, 166, 124, 0.32);
}

.trip-check-mark {
    color: #ffffff;
    font-size: 24rpx;
    font-size: calc(24rpx * var(--fs, 1));
    font-weight: 700;
    line-height: 1;
}

.trip-main {
    flex: 1;
    min-width: 0;
}

.trip-line {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
}

.trip-title {
    flex: 1;
    min-width: 0;
    padding-right: 16rpx;
    color: #101828;
    font-size: 30rpx;
    font-size: calc(30rpx * var(--fs, 1));
    font-weight: 600;
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.trip-title.is-done {
    color: #A2AAB8;
    text-decoration: line-through;
}

.trip-time {
    flex-shrink: 0;
    padding: 4rpx 14rpx;
    border-radius: 10rpx;
    background: linear-gradient(135deg, #EEF2FF 0%, #F1EDFF 100%);
    color: #4353D6;
    font-size: 24rpx;
    font-size: calc(24rpx * var(--fs, 1));
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.5;
}

.trip-meta {
    display: flex;
    align-items: center;
    margin-top: 14rpx;
}

.trip-cat {
    padding: 4rpx 14rpx;
    border-radius: 8rpx;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
    font-weight: 600;
    line-height: 1.5;
}

.trip-remind {
    margin-left: 14rpx;
    color: #98A2B3;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
}

.trip-note {
    display: block;
    margin-top: 10rpx;
    color: #77808F;
    font-size: 24rpx;
    font-size: calc(24rpx * var(--fs, 1));
    line-height: 1.5;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.past-toggle {
    margin-top: 28rpx;
    padding: 22rpx 0;
    color: #8A93A6;
    font-size: 25rpx;
    font-size: calc(25rpx * var(--fs, 1));
    text-align: center;
}

/* ---------- 日历 ---------- */
.cal-card {
    margin-top: 28rpx;
    padding: 24rpx 20rpx 20rpx;
    border: 2rpx solid rgba(16, 24, 40, 0.04);
    border-radius: 30rpx;
    background: linear-gradient(180deg, #ffffff 0%, #FCFDFF 100%);
    box-shadow: 0 2rpx 6rpx rgba(16, 24, 40, 0.04), 0 16rpx 34rpx rgba(16, 24, 40, 0.07);
}

.cal-head {
    display: flex;
    align-items: center;
    padding: 0 4rpx 12rpx;
}

.cal-move {
    display: flex;
    flex: 1;
    align-items: center;
    min-width: 0;
}

.cal-nav {
    display: flex;
    width: 56rpx;
    height: 56rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #F1F4FC;
    color: #4B5468;
    font-size: 34rpx;
    font-size: calc(34rpx * var(--fs, 1));
    line-height: 1;
}

.cal-title {
    margin: 0 10rpx;
    color: #101828;
    font-size: 29rpx;
    font-size: calc(29rpx * var(--fs, 1));
    font-weight: 700;
    white-space: nowrap;
}

.cal-mode {
    display: flex;
    flex-shrink: 0;
    padding: 4rpx;
    border-radius: 999rpx;
    background: #EFF2FA;
    box-shadow: inset 0 2rpx 6rpx rgba(16, 24, 40, 0.05);
}

.cal-mode-item {
    padding: 8rpx 20rpx;
    border-radius: 999rpx;
    color: #667085;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
}

.cal-mode-item.is-active {
    background: #ffffff;
    color: #3B4BFF;
    font-weight: 600;
    box-shadow: 0 4rpx 10rpx rgba(16, 24, 40, 0.1);
}

.cal-week-row {
    display: flex;
    padding: 10rpx 0 4rpx;
}

.cal-week-cell {
    flex: 1;
    color: #A2AAB8;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
    text-align: center;
}

.cal-week {
    display: flex;
}

.cal-cell {
    position: relative;
    display: flex;
    height: 84rpx;
    flex: 1;
    align-items: center;
    flex-direction: column;
    justify-content: center;
}

.cal-day {
    width: 58rpx;
    height: 58rpx;
    border-radius: 50%;
    color: #2A3346;
    font-size: 27rpx;
    font-size: calc(27rpx * var(--fs, 1));
    line-height: 58rpx;
    text-align: center;
    transition: background 0.16s ease, color 0.16s ease;
}

.cal-cell.is-out .cal-day {
    color: #C7CCD8;
}

.cal-cell.is-today .cal-day {
    background: #EAEFFF;
    color: #3B4BFF;
    font-weight: 700;
}

.cal-cell.is-selected .cal-day {
    background: linear-gradient(135deg, #5B76FF 0%, #7B5CFF 100%);
    color: #ffffff;
    font-weight: 700;
    box-shadow: 0 8rpx 18rpx rgba(86, 102, 255, 0.34);
}

.cal-dot {
    position: absolute;
    bottom: 4rpx;
    width: 8rpx;
    height: 8rpx;
    border-radius: 50%;
    background: linear-gradient(135deg, #5B76FF 0%, #8B5CF6 100%);
}

.cal-cell.is-out .cal-dot {
    background: #C7CCD8;
}

.cal-cell.is-selected .cal-dot {
    background: #5B76FF;
}

.cal-tip {
    display: block;
    margin-top: 10rpx;
    color: #B4BAC7;
    font-size: 21rpx;
    font-size: calc(21rpx * var(--fs, 1));
    text-align: center;
}

.selected-head {
    display: flex;
    align-items: baseline;
    margin-top: 36rpx;
    padding: 0 8rpx 16rpx;
}

.selected-title {
    color: #101828;
    font-size: 29rpx;
    font-size: calc(29rpx * var(--fs, 1));
    font-weight: 700;
}

.selected-meta {
    margin-left: auto;
    color: #A2AAB8;
    font-size: 24rpx;
    font-size: calc(24rpx * var(--fs, 1));
}

/* ---------- 悬浮按钮 ---------- */
.fab {
    position: fixed;
    right: 40rpx;
    bottom: 56rpx;
    bottom: calc(56rpx + env(safe-area-inset-bottom));
    display: flex;
    width: 112rpx;
    height: 112rpx;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #5B76FF 0%, #6F5BFF 55%, #8B5CF6 100%);
    box-shadow: 0 12rpx 24rpx rgba(76, 90, 255, 0.3), 0 24rpx 46rpx rgba(76, 90, 255, 0.42), inset 0 2rpx 0 rgba(255, 255, 255, 0.4);
    transition: transform 0.16s ease;
}

.fab-hover {
    transform: scale(0.94);
}

.fab-plus {
    margin-top: -6rpx;
    color: #ffffff;
    font-size: 58rpx;
    font-size: calc(58rpx * var(--fs, 1));
    font-weight: 300;
    line-height: 1;
}

/* ---------- 账号区域 ---------- */
.account-box {
    display: flex;
    flex-direction: column;
    flex-shrink: 0;
    margin: 4rpx 0 16rpx;
    padding: 20rpx 24rpx 18rpx;
    border: 2rpx solid #E7ECF8;
    border-radius: 22rpx;
    background: linear-gradient(135deg, #F7F9FF 0%, #F3F5FE 100%);
}

.account-row {
    display: flex;
    align-items: center;
}

.account-avatar {
    display: flex;
    width: 68rpx;
    height: 68rpx;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: linear-gradient(135deg, #5B76FF 0%, #8B5CF6 100%);
    color: #ffffff;
    font-size: 28rpx;
    font-size: calc(28rpx * var(--fs, 1));
    font-weight: 700;
    box-shadow: 0 8rpx 18rpx rgba(86, 102, 255, 0.3);
}

.account-info {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
    margin-left: 18rpx;
}

.account-name {
    color: #101828;
    font-size: 27rpx;
    font-size: calc(27rpx * var(--fs, 1));
    font-weight: 600;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.account-sub {
    margin-top: 4rpx;
    color: #98A2B3;
    font-size: 21rpx;
    font-size: calc(21rpx * var(--fs, 1));
}

/* 账号管理项：明确的按钮形态，整行可点，危险操作用红色 */
.account-logout {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 16rpx;
    padding: 20rpx 24rpx;
    border: 2rpx solid #F6D3D3;
    border-radius: 16rpx;
    background: #FFF7F7;
}

.account-logout-text {
    color: #D14343;
    font-size: 26rpx;
    font-size: calc(26rpx * var(--fs, 1));
    font-weight: 600;
}

.account-logout-arrow {
    margin-left: 10rpx;
    color: #E2A0A0;
    font-size: 28rpx;
    line-height: 1;
}

.account-logout-hover {
    background: #FFECEC;
}

/* 二次确认态：整块变红，文案换成「再次点击，确认退出登录」 */
.account-logout.is-confirming {
    border-color: #D14343;
    background: #D14343;
    border-radius: 16rpx;
    padding: 20rpx 24rpx;
}

.account-logout.is-confirming .account-logout-text,
.account-logout.is-confirming .account-logout-arrow {
    color: #ffffff;
}

/* ---------- 设置面板：分组标签 ---------- */
.sheet-row-label {
    display: block;
    margin: 8rpx 0 -6rpx;
    color: #6B7280;
    font-size: 24rpx;
    font-size: calc(24rpx * var(--fs, 1));
    font-weight: 600;
}

/* ---------- 设置面板：云同步 ---------- */
.cloud-card {
    margin-top: 14rpx;
    padding: 22rpx 24rpx 20rpx;
    border: 2rpx solid #E3E9FA;
    border-radius: 22rpx;
    background: #FCFDFF;
}

.cloud-head {
    display: flex;
    align-items: center;
}

.cloud-dot {
    width: 14rpx;
    height: 14rpx;
    margin-right: 12rpx;
    border-radius: 50%;
    background: #C6CCDA;
    flex-shrink: 0;
}

.cloud-dot.is-on {
    background: #1FA971;
}

.cloud-title {
    flex: 1;
    color: #16191F;
    font-size: 26rpx;
    font-size: calc(26rpx * var(--fs, 1));
    font-weight: 600;
}

.cloud-badge {
    color: #4F63FF;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
}

.cloud-sub {
    display: block;
    margin-top: 8rpx;
    color: #7C86A8;
    font-size: 22rpx;
    font-size: calc(22rpx * var(--fs, 1));
    line-height: 1.45;
}

.cloud-actions {
    display: flex;
    margin-top: 16rpx;
}

.cloud-btn {
    flex: 1;
    height: 68rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 18rpx;
    background: #2B5CE6;
    color: #FFFFFF;
    font-size: 25rpx;
    font-size: calc(25rpx * var(--fs, 1));
    font-weight: 600;
}

.cloud-btn-ghost {
    margin-left: 16rpx;
    background: #F1F4FB;
    color: #3546C9;
    border: 2rpx solid #DCE3F6;
}
